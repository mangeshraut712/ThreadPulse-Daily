{
  "name": "threadpulse-daily",
  "version": "2026.1.0",
  "description": "ThreadPulse Daily — A community-powered daily word puzzle game for Reddit.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:devvit": "node scripts/build-devvit.mjs",
    "preview": "vite preview",
    "lint": "eslint src apps/devvit/src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:self": "node scripts/self-test.mjs",
    "simulate": "node scripts/simulateGame.mjs",
    "balance": "node scripts/balance-check.mjs",
    "check:submission": "node scripts/submission-check.mjs",
    "verify:final": "node scripts/final-verify.mjs",
    "qa": "npm run typecheck && npm run lint && npm run test && npm run test:self && npm run balance && npm run check:submission && npm run verify:final"
  },
  "dependencies": {
    "@devvit/public-api": "^0.10.21",
    "@tensorflow/tfjs": "^4.15.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/json-schema": "^7.0.15",
    "@types/long": "^4.0.2",
    "@types/node": "^25.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/offscreencanvas": "^2019.7.3",
    "@types/prop-types": "^15.7.15",
    "@types/seedrandom": "^3.0.8",
    "@types/semver": "^7.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.5",
    "wasm-pack": "^0.15.0"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "reddit",
    "devvit",
    "game",
    "ai",
    "gamemaker",
    "webassembly",
    "mobile",
    "pwa",
    "hackathon",
    "daily-games",
    "tensorflow",
    "typescript"
  ],
  "author": "ThreadPulse Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/threadpulse/threadpulse-daily-2026"
  },
  "bugs": {
    "url": "https://github.com/threadpulse/threadpulse-daily-2026/issues"
  },
  "homepage": "https://threadpulse-daily.reddit.com"
}
